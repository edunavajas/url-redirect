# Base de datos (Postgres connection string)
DATABASE_URL=postgres://urlredirect:urlredirect@localhost:5432/urlredirect
IP_SALT=change-this-random-string-32chars

# JWT para admin
JWT_SECRET=change-this-super-secret-jwt-key-256bits
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# URLs base
REDIRECT_BASE_URL=https://go.tudominio.com
ADMIN_BASE_URL=https://admin.tudominio.com

# Puertos
PORT=3000
ADMIN_PORT=3001

# Deep links nativos (abrir app de YouTube desde in-app browsers).
# Poner a 'true' para desactivar globalmente en caliente (kill-switch).
DEEP_LINKS_DISABLED=false
